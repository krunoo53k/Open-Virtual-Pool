[configuration]
entry_symbol = "gdext_rust_init"
; The extension is built against the Godot 4.6 API, so it needs a runtime of
; 4.6 or later.
compatibility_minimum = "4.6"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libpool_godot.so"
linux.release.x86_64 = "res://bin/libpool_godot.so"
windows.debug.x86_64 = "res://bin/pool_godot.dll"
windows.release.x86_64 = "res://bin/pool_godot.dll"
macos.debug = "res://bin/libpool_godot.dylib"
macos.release = "res://bin/libpool_godot.dylib"
